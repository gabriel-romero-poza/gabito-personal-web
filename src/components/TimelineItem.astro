---
/**
 * Un ítem de timeline (trabajo o educación). Misma estructura para ambos (DRY).
 * El tipo TimelineEntry está definido en types/portfolio.ts.
 */
import type { TimelineEntry } from '../types/portfolio';

export interface Props {
  item: TimelineEntry;
}
const { item } = Astro.props;
---

<div class="flex gap-4">
  <div class="flex flex-col items-center">
    <div class="timeline-dot"></div>
    <div class="w-px flex-1 bg-border mt-2"></div>
  </div>
  <div class="pb-4">
    <h3 class="font-semibold text-white text-sm">{item.role}</h3>
    <p class="font-mono text-accent text-xs mt-0.5">{item.company}</p>
    <p class="text-muted text-xs mt-1">{item.date} · {item.location}</p>
    {item.desc && <p class="text-muted text-xs mt-2 leading-relaxed">{item.desc}</p>}
    {item.bullets && item.bullets.length > 0 && (
      <ul class="mt-2 space-y-1.5 list-none m-0 p-0">
        {item.bullets.map((bullet) => (
          <li class="flex gap-2 text-muted text-xs leading-relaxed">
            <span class="text-accent flex-shrink-0 mt-0.5" aria-hidden="true">›</span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
