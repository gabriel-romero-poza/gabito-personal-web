---
/**
 * Bloque "Sobre mí": texto, enlace destacado, placeholder de foto y lista de stack.
 * Recibe el slice de traducciones about y el array stack (inyectado desde la página).
 */
export interface Props {
  about: {
    title: string;
    p1: string;
    p2: { before: string; linkText: string; after: string; href: string };
    stack: string;
    photoPlaceholder: string;
  };
  stack: string[];
  /** Ruta a la foto (ej. /avatar.jpg). Si no se pasa, se muestra el placeholder. */
  avatarSrc?: string;
}
const { about, stack, avatarSrc } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
  <div class="space-y-4 text-muted leading-relaxed">
    <p>{about.p1}</p>
    <p>
      {about.p2.before}
      <a href={about.p2.href} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">{about.p2.linkText}</a>
      {about.p2.after}
    </p>
  </div>
  <div class="flex flex-col items-center gap-6">
    <div class="w-40 h-40 rounded-full border-2 border-accent/30 bg-gradient-to-br from-surface to-blue-950/20 flex items-center justify-center overflow-hidden glow">
      {avatarSrc ? (
        <picture>
          <source srcset={avatarSrc.replace(/\.png$/, '.webp')} type="image/webp" />
          <img
            src={avatarSrc}
            alt="Gabriel Romero Poza"
            class="w-full h-full object-cover"
            width="160"
            height="160"
            loading="lazy"
          />
        </picture>
      ) : (
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
        </svg>
      )}
    </div>
    {!avatarSrc && <p class="text-xs font-mono text-subtle text-center">{about.photoPlaceholder}</p>}
  </div>
</div>

  <div class="mt-14">
    <p class="font-mono text-xs text-muted uppercase tracking-widest mb-6">{about.stack}</p>
    <div class="rounded-xl border border-border bg-gradient-to-br from-surface/60 via-surface/40 to-blue-950/15 px-6 py-5 backdrop-blur-sm hover:border-accent/40 transition-colors">
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2.5 list-none m-0 p-0">
        {stack.map((tech) => (
          <li class="flex items-center gap-2 group">
            <div class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0 group-hover:bg-accent-hover group-hover:scale-125 group-hover:shadow-[0_0_6px_rgba(37,99,235,0.5)] transition-all" style="background-color: #2563eb;"></div>
            <span class="text-sm text-muted font-mono group-hover:text-white transition-colors leading-none">{tech}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
