---
/**
 * Sección experiencia: dos columnas (trabajo y educación) con timeline.
 * Reutiliza TimelineItem para ambas listas (DRY); la forma de datos es la misma.
 */
import type { TimelineEntry } from '../types/portfolio';
import TimelineItem from './TimelineItem.astro';

export interface Props {
  title: string;
  exp_label: string;
  edu_label: string;
  jobs: TimelineEntry[];
  education: TimelineEntry[];
}
const { title, exp_label, edu_label, jobs, education } = Astro.props;
---

<section id="experience" class="py-24 border-t border-border">
  <div class="max-w-4xl mx-auto px-6">
    <p class="font-mono text-accent text-xs tracking-widest uppercase mb-2">03</p>
    <h2 class="text-2xl sm:text-3xl font-semibold mb-10">{title}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <p class="font-mono text-xs text-muted uppercase tracking-widest mb-6">{exp_label}</p>
        <div class="space-y-8">
          {jobs.map((job) => (
            <TimelineItem item={job} />
          ))}
        </div>
      </div>
      <div>
        <p class="font-mono text-xs text-muted uppercase tracking-widest mb-6">{edu_label}</p>
        <div class="space-y-8">
          {education.map((edu) => (
            <TimelineItem item={edu} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
