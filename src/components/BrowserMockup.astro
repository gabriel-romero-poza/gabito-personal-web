---
/**
 * Mockup mínimo de ventana de navegador (barra + área de contenido).
 * Reutilizable para cualquier proyecto; el título viene por props.
 */
export interface Props {
  /** Texto en la barra del navegador (p. ej. dominio del proyecto). */
  title: string;
}
const { title } = Astro.props;
---

<div class="w-full h-52 bg-gradient-to-br from-[#0d1117] to-[#0f172a] border-b border-border">
  <div class="h-8 bg-[#161b22] border-b border-[#1f1f1f] flex items-center px-4 gap-2">
    <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
    <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
    <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
    <span class="mx-auto font-mono text-[10px] text-[#444]">{title}</span>
  </div>
  <div class="p-4 flex gap-3">
    <div class="w-24 h-20 bg-surface/50 rounded border border-border" />
    <div class="flex-1 space-y-2">
      <div class="h-3 w-3/4 bg-subtle/50 rounded" />
      <div class="h-3 w-full bg-subtle/50 rounded" />
      <div class="h-3 w-1/2 bg-accent/20 rounded" />
    </div>
  </div>
</div>
