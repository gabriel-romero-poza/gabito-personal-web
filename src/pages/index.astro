---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLangFromUrl } from '../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stack = [
  'TypeScript', 'Node.js', 'NestJS', 'Next.js', 'React',
  'PostgreSQL', 'Drizzle ORM', 'JWT', 'REST APIs', 'Git', 'Vercel', 'Python'
];

const otherLang = lang === 'es' ? 'en' : 'es';
const otherLangLabel = lang === 'es' ? 'EN' : 'ES';
const otherLangPath = lang === 'es' ? '/en' : '/';
---

<Layout title="Gabriel Romero Poza" lang={lang}>
  <!-- NAVBAR -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg/80 backdrop-blur-sm">
    <div class="max-w-4xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="#hero" class="font-mono text-sm text-white font-medium tracking-tight">
        grp<span class="text-accent">.</span>dev
      </a>
      <div class="flex items-center gap-6">
        <a href="#about" class="nav-link">{t.nav.about}</a>
        <a href="#projects" class="nav-link">{t.nav.projects}</a>
        <a href="#experience" class="nav-link">{t.nav.experience}</a>
        <a href="#contact" class="nav-link">{t.nav.contact}</a>
        <a
          href={otherLangPath}
          class="font-mono text-xs px-2.5 py-1 border border-border rounded text-muted hover:border-accent hover:text-accent transition-colors"
        >
          {otherLangLabel}
        </a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section id="hero" class="min-h-screen flex items-center grid-bg pt-14">
    <div class="max-w-4xl mx-auto px-6 py-24">
      <p class="fade-up fade-up-1 font-mono text-accent text-sm mb-4 tracking-widest uppercase">
        {t.hero.greeting}
      </p>
      <h1 class="fade-up fade-up-2 text-5xl sm:text-7xl font-semibold text-white leading-none tracking-tight mb-4">
        Gabriel<br/>
        <span class="text-white/30">Romero Poza</span>
      </h1>
      <p class="fade-up fade-up-3 font-mono text-lg text-muted mt-6 mb-3">
        {t.hero.title}<span class="cursor text-accent">_</span>
      </p>
      <p class="fade-up fade-up-3 text-muted text-base max-w-md mb-10">
        {t.hero.subtitle}
      </p>
      <div class="fade-up fade-up-4 flex gap-4 flex-wrap">
        <a
          href="#projects"
          class="px-5 py-2.5 bg-accent hover:bg-accent-hover text-white text-sm font-medium rounded transition-colors font-mono"
        >
          {t.hero.cta_projects}
        </a>
        <a
          href="#contact"
          class="px-5 py-2.5 border border-border hover:border-accent text-muted hover:text-white text-sm font-medium rounded transition-colors font-mono"
        >
          {t.hero.cta_contact}
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-24 border-t border-border">
    <div class="max-w-4xl mx-auto px-6">
      <p class="font-mono text-accent text-xs tracking-widest uppercase mb-2">01</p>
      <h2 class="text-3xl font-semibold mb-10">{t.about.title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div class="space-y-4 text-muted leading-relaxed">
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
        </div>
        <!-- Photo placeholder -->
        <div class="flex flex-col items-center gap-6">
          <div class="w-40 h-40 rounded-full border-2 border-border bg-surface flex items-center justify-center glow">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5">
              <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
          </div>
          <p class="text-xs font-mono text-subtle text-center">— foto por agregar —</p>
        </div>
      </div>

      <!-- Stack -->
      <div class="mt-14">
        <p class="font-mono text-xs text-muted uppercase tracking-widest mb-4">{t.about.stack}</p>
        <div class="flex flex-wrap gap-2">
          {stack.map(s => <span class="tag">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="py-24 border-t border-border">
    <div class="max-w-4xl mx-auto px-6">
      <p class="font-mono text-accent text-xs tracking-widest uppercase mb-2">02</p>
      <h2 class="text-3xl font-semibold mb-10">{t.projects.title}</h2>

      <!-- Escolaris card -->
      <div class="rounded-xl border border-border bg-surface overflow-hidden hover:border-accent/40 transition-colors group glow">
        <!-- Mock screenshot -->
        <div class="w-full h-52 bg-gradient-to-br from-[#0d1117] to-[#0f172a] border-b border-border relative overflow-hidden">
          <!-- Fake browser chrome -->
          <div class="absolute top-0 left-0 right-0 h-8 bg-[#161b22] border-b border-[#1f1f1f] flex items-center px-4 gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
            <div class="mx-auto font-mono text-[10px] text-[#444] bg-[#0d1117] px-4 py-0.5 rounded">
              escolaris.com.ar
            </div>
          </div>
          <!-- Fake UI -->
          <div class="absolute top-10 left-0 right-0 bottom-0 p-4 flex gap-3">
            <!-- Sidebar -->
            <div class="w-28 bg-[#0d1117] rounded border border-[#1f1f1f] p-2 space-y-2 flex-shrink-0">
              <div class="h-4 w-full bg-accent/20 rounded"></div>
              <div class="h-3 w-3/4 bg-[#1f2937] rounded"></div>
              <div class="h-3 w-full bg-[#1f2937] rounded"></div>
              <div class="h-3 w-2/3 bg-[#1f2937] rounded"></div>
              <div class="h-3 w-full bg-[#1f2937] rounded"></div>
              <div class="h-3 w-3/4 bg-[#1f2937] rounded"></div>
            </div>
            <!-- Main content -->
            <div class="flex-1 space-y-2">
              <div class="flex gap-2">
                <div class="flex-1 bg-[#0d1117] rounded border border-[#1f1f1f] p-2">
                  <div class="h-2 w-1/2 bg-accent/30 rounded mb-2"></div>
                  <div class="h-5 w-1/3 bg-accent/20 rounded font-mono text-[9px] text-accent flex items-center justify-center">248</div>
                </div>
                <div class="flex-1 bg-[#0d1117] rounded border border-[#1f1f1f] p-2">
                  <div class="h-2 w-1/2 bg-[#1f2937] rounded mb-2"></div>
                  <div class="h-5 w-1/3 bg-[#1f2937] rounded"></div>
                </div>
                <div class="flex-1 bg-[#0d1117] rounded border border-[#1f1f1f] p-2">
                  <div class="h-2 w-1/2 bg-[#1f2937] rounded mb-2"></div>
                  <div class="h-5 w-1/3 bg-[#1f2937] rounded"></div>
                </div>
              </div>
              <div class="bg-[#0d1117] rounded border border-[#1f1f1f] p-2 space-y-1.5">
                {[1,2,3].map(() => (
                  <div class="flex gap-2 items-center">
                    <div class="w-2 h-2 rounded-full bg-accent/40 flex-shrink-0"></div>
                    <div class="h-2 flex-1 bg-[#1f2937] rounded"></div>
                    <div class="h-2 w-12 bg-[#1f2937] rounded"></div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="p-6">
          <div class="flex items-start justify-between mb-3">
            <div>
              <h3 class="text-xl font-semibold text-white">{t.projects.escolaris.title}</h3>
              <span class="font-mono text-xs text-accent">{t.projects.escolaris.badge}</span>
            </div>
            <a
              href="https://escolaris.com.ar"
              target="_blank"
              rel="noopener"
              class="flex items-center gap-1.5 text-xs font-mono text-muted hover:text-accent transition-colors border border-border hover:border-accent/40 px-3 py-1.5 rounded"
            >
              {t.projects.escolaris.link}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
            </a>
          </div>
          <p class="text-muted text-sm leading-relaxed mb-4">{t.projects.escolaris.desc}</p>
          <div class="flex flex-wrap gap-2">
            {t.projects.escolaris.tags.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="py-24 border-t border-border">
    <div class="max-w-4xl mx-auto px-6">
      <p class="font-mono text-accent text-xs tracking-widest uppercase mb-2">03</p>
      <h2 class="text-3xl font-semibold mb-10">{t.experience.title}</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Jobs -->
        <div>
          <p class="font-mono text-xs text-muted uppercase tracking-widest mb-6">{t.experience.exp_label}</p>
          <div class="space-y-8">
            {t.experience.jobs.map((job: any) => (
              <div class="flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="timeline-dot"></div>
                  <div class="w-px flex-1 bg-border mt-2"></div>
                </div>
                <div class="pb-4">
                  <h4 class="font-semibold text-white text-sm">{job.role}</h4>
                  <p class="font-mono text-accent text-xs mt-0.5">{job.company}</p>
                  <p class="text-muted text-xs mt-1">{job.date} · {job.location}</p>
                  {job.desc && <p class="text-muted text-xs mt-2 leading-relaxed">{job.desc}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Education -->
        <div>
          <p class="font-mono text-xs text-muted uppercase tracking-widest mb-6">{t.experience.edu_label}</p>
          <div class="space-y-8">
            {t.experience.education.map((edu: any) => (
              <div class="flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="timeline-dot"></div>
                  <div class="w-px flex-1 bg-border mt-2"></div>
                </div>
                <div class="pb-4">
                  <h4 class="font-semibold text-white text-sm">{edu.role}</h4>
                  <p class="font-mono text-accent text-xs mt-0.5">{edu.company}</p>
                  <p class="text-muted text-xs mt-1">{edu.date} · {edu.location}</p>
                  {edu.desc && <p class="text-muted text-xs mt-2 leading-relaxed">{edu.desc}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-24 border-t border-border">
    <div class="max-w-4xl mx-auto px-6">
      <p class="font-mono text-accent text-xs tracking-widest uppercase mb-2">04</p>
      <h2 class="text-3xl font-semibold mb-3">{t.contact.title}</h2>
      <p class="text-muted mb-10 max-w-sm">{t.contact.subtitle}</p>
      <div class="flex flex-wrap gap-4">
        <a
          href="mailto:gabriel.r.poza@gmail.com"
          class="flex items-center gap-2 px-5 py-2.5 bg-accent hover:bg-accent-hover text-white text-sm font-mono rounded transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          {t.contact.email}
        </a>
        <a
          href="https://github.com"
          target="_blank"
          class="flex items-center gap-2 px-5 py-2.5 border border-border hover:border-accent/50 text-muted hover:text-white text-sm font-mono rounded transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          {t.contact.github}
        </a>
        <a
          href="https://linkedin.com"
          target="_blank"
          class="flex items-center gap-2 px-5 py-2.5 border border-border hover:border-accent/50 text-muted hover:text-white text-sm font-mono rounded transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          {t.contact.linkedin}
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-border py-8">
    <div class="max-w-4xl mx-auto px-6 flex justify-between items-center">
      <p class="font-mono text-xs text-subtle">
        {t.footer.made} <span class="text-accent">♥</span> {t.footer.in}
      </p>
      <p class="font-mono text-xs text-subtle">Gabriel Romero Poza © 2026</p>
    </div>
  </footer>
</Layout>
