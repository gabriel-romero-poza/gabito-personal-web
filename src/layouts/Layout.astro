---
import '../styles/global.css';
import type { Lang } from '../i18n/index';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}
const { title, description, lang } = Astro.props;

const site = (Astro.site?.origin ?? 'https://gabito.vercel.app').replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = `${site}${pathname === '/' ? '/' : `${pathname}/`}`;
const alternateEs = `${site}/`;
const alternateEn = `${site}/en/`;
const ogImage = `${site}/avatar.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/#person`,
      name: 'Gabriel Emmanuel Romero Poza',
      url: site,
      image: ogImage,
      jobTitle: 'Full-Stack Developer',
      email: 'mailto:gabriel.r.poza@gmail.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Bahía Blanca',
        addressRegion: 'Buenos Aires',
        addressCountry: 'AR',
      },
      sameAs: [
        'https://github.com/gabriel-romero-poza',
        'https://www.linkedin.com/in/gabrielromero-dev',
        'https://mecaris.ar',
      ],
      knowsAbout: [
        'desarrollo web',
        'páginas web',
        'sistemas a medida',
        'software a medida',
        'SaaS',
        'TypeScript',
        'NestJS',
        'Next.js',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'Gabriel Romero Poza',
      description,
      inLanguage: ['es', 'en'],
      publisher: { '@id': `${site}/#person` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site}/#services`,
      name: lang === 'es' ? 'Desarrollo web y sistemas a medida' : 'Web development and custom software',
      url: `${site}${lang === 'es' ? '/' : '/en/'}#services`,
      provider: { '@id': `${site}/#person` },
      areaServed: [
        { '@type': 'City', name: 'Bahía Blanca' },
        { '@type': 'Country', name: 'Argentina' },
      ],
      serviceType: [
        lang === 'es' ? 'Hacer página web' : 'Website development',
        lang === 'es' ? 'Sistema a medida' : 'Custom software systems',
        'SaaS',
      ],
    },
  ],
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Romero Poza" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_AR'} />
    <meta property="og:site_name" content="Gabriel Romero Poza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Gabriel Romero Poza" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" /></noscript>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      * { box-sizing: border-box; }
      html {
        background-color: #0a0a0a;
        font-size: 100%;
        -webkit-text-size-adjust: 100%;
      }
      ::selection { background: #2563eb33; color: #fff; }
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: #0a0a0a; }
      ::-webkit-scrollbar-thumb { background: #2563eb; border-radius: 2px; }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
      }
      .fade-up { animation: fadeUp 0.7s ease forwards; }
      .fade-up-1 { animation-delay: 0.1s; opacity: 0; }
      .fade-up-2 { animation-delay: 0.25s; opacity: 0; }
      .fade-up-3 { animation-delay: 0.4s; opacity: 0; }
      .fade-up-4 { animation-delay: 0.55s; opacity: 0; }
      .cursor { animation: blink 1s step-end infinite; }

      .grid-bg {
        background-image:
          linear-gradient(rgba(37,99,235,0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(37,99,235,0.06) 1px, transparent 1px);
        background-size: 48px 48px;
        background-color: #0a0a0a;
        position: relative;
      }
      .grid-bg::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 50%, rgba(37,99,235,0.03) 0%, transparent 70%);
        pointer-events: none;
      }
      .glow { box-shadow: 0 0 60px rgba(37,99,235,0.15); }
      .tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid rgba(37,99,235,0.2);
        color: #9ca3af;
        background: rgba(37,99,235,0.05);
        transition: border-color 0.2s, color 0.2s, background 0.2s;
      }
      .tag:hover { border-color: #2563eb; color: #60a5fa; background: rgba(37,99,235,0.1); }

      .nav-link {
        position: relative;
        font-size: 0.85rem;
        color: #6b7280;
        transition: color 0.2s;
        font-family: 'JetBrains Mono', monospace;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -2px; left: 0;
        width: 0; height: 1px;
        background: #2563eb;
        transition: width 0.2s;
      }
      .nav-link:hover { color: #fff; }
      .nav-link:hover::after { width: 100%; }

      .timeline-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: #2563eb;
        flex-shrink: 0;
        margin-top: 6px;
        box-shadow: 0 0 8px rgba(37,99,235,0.5);
      }
      .btn-primary {
        padding: 0.625rem 1.25rem;
        background: #2563eb;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.25rem;
        transition: background-color 0.2s;
        font-family: 'JetBrains Mono', monospace;
      }
      .btn-primary:hover { background: #3b82f6; }
      .btn-secondary {
        padding: 0.625rem 1.25rem;
        border: 1px solid rgba(37,99,235,0.2);
        color: #6b7280;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.25rem;
        background: rgba(37,99,235,0.03);
        transition: border-color 0.2s, color 0.2s, background 0.2s;
        font-family: 'JetBrains Mono', monospace;
      }
      .btn-secondary:hover { border-color: #2563eb; color: #fff; background: rgba(37,99,235,0.1); }
    </style>
  </head>
  <body class="bg-bg text-white font-sans text-base antialiased">
    <main>
      <slot />
    </main>
  </body>
</html>
