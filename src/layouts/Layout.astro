---
import '../styles/global.css';

interface Props {
  title?: string;
  lang?: string;
}
const { title = 'Gabriel Romero Poza', lang = 'es' } = Astro.props;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gabriel Romero Poza — Full-Stack Developer & Founder of Escolaris" />
    <title>{title}</title>
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      html {
        background-color: #0a0a0a;
        font-size: 100%;
        -webkit-text-size-adjust: 100%;
      }
      ::selection { background: #2563eb33; color: #fff; }
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: #0a0a0a; }
      ::-webkit-scrollbar-thumb { background: #2563eb; border-radius: 2px; }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
      }
      .fade-up { animation: fadeUp 0.7s ease forwards; }
      .fade-up-1 { animation-delay: 0.1s; opacity: 0; }
      .fade-up-2 { animation-delay: 0.25s; opacity: 0; }
      .fade-up-3 { animation-delay: 0.4s; opacity: 0; }
      .fade-up-4 { animation-delay: 0.55s; opacity: 0; }
      .cursor { animation: blink 1s step-end infinite; }

      .grid-bg {
        background-image:
          linear-gradient(rgba(37,99,235,0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(37,99,235,0.04) 1px, transparent 1px);
        background-size: 48px 48px;
      }
      .glow { box-shadow: 0 0 60px rgba(37,99,235,0.12); }
      .tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid #1f1f1f;
        color: #9ca3af;
        background: #111;
        transition: border-color 0.2s, color 0.2s;
      }
      .tag:hover { border-color: #2563eb; color: #60a5fa; }

      .nav-link {
        position: relative;
        font-size: 0.85rem;
        color: #6b7280;
        transition: color 0.2s;
        font-family: 'JetBrains Mono', monospace;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -2px; left: 0;
        width: 0; height: 1px;
        background: #2563eb;
        transition: width 0.2s;
      }
      .nav-link:hover { color: #fff; }
      .nav-link:hover::after { width: 100%; }

      .timeline-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: #2563eb;
        flex-shrink: 0;
        margin-top: 6px;
        box-shadow: 0 0 8px rgba(37,99,235,0.5);
      }
      /* Botones reutilizables (DRY): mismo aspecto en Hero y Contact */
      .btn-primary {
        padding: 0.625rem 1.25rem;
        background: #2563eb;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.25rem;
        transition: background-color 0.2s;
        font-family: 'JetBrains Mono', monospace;
      }
      .btn-primary:hover { background: #3b82f6; }
      .btn-secondary {
        padding: 0.625rem 1.25rem;
        border: 1px solid #1f1f1f;
        color: #6b7280;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.25rem;
        transition: border-color 0.2s, color 0.2s;
        font-family: 'JetBrains Mono', monospace;
      }
      .btn-secondary:hover { border-color: #2563eb; color: #fff; }
    </style>
  </head>
  <body class="bg-bg text-white font-sans text-base antialiased">
    <slot />
  </body>
</html>
